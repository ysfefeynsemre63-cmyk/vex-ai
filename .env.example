# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Must exactly match the verified owner email
ADMIN_EMAIL=owner@example.com

# Generate a long random value; use only once for initial bootstrap
ADMIN_BOOTSTRAP_SECRET=replace_with_a_long_random_secret

# Site configuration
SITE_NAME=VEX AI
